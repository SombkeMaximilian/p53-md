; Production MD
; @TEMP@ is inserted by the Makefile

integrator              = md
dt                      = 0.002
nsteps                  = 10000000

nstxout-compressed      = 5000
compressed-x-grps       = System
nstlog                  = 50000
nstenergy               = 5000

continuation            = yes
constraint-algorithm    = lincs
constraints             = h-bonds
lincs-iter              = 1
lincs-order             = 4

cutoff-scheme           = Verlet
nstlist                 = 40
pbc                     = xyz

coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
pme-order               = 4

vdwtype                 = cutoff
vdw-modifier            = potential-shift-verlet
rvdw                    = 1.0
DispCorr                = EnerPres

tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = @TEMP@

gen-vel                 = no
