integrator     = steep
emtol          = 100.0
emstep         = 0.01
nsteps         = 50000

cutoff-scheme  = Verlet
nstlist        = 10
pbc            = xyz

coulombtype    = PME
rcoulomb       = 1.0
fourierspacing = 0.12

vdwtype        = cutoff
vdw-modifier   = potential-shift-verlet
rvdw           = 1.0
rlist          = 1.0
DispCorr       = EnerPres

constraints    = none
